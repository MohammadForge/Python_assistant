def calculator():

    print('\n -----CALCULATOR-----')
    num_1 = int(input('Enter first number: '))
    num_2 = input('Choose(+,-,*,/): ')
    num_3 = int(input('Enter second number: '))

    if num_2 == '+':
        print(num_1 + num_3)
    
    elif num_2 == '-':
        print(num_1 - num_3)

    elif num_2 == '*':
        print(num_1 * num_3)

    elif num_2 == '/':
        if num_3 == 0:
            print('Cannot divide by zero!')
        else:
            print(num_1 / num_3)

